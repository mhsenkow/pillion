{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Pillion — Vite SPA + Overpass OSM proxy. Deploy: npm run deploy → pillion.ibm.io
  "name": "pillion",
  "main": "worker/osmProxy.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "pillion.ibm.io", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
